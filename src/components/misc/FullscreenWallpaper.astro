---
import { siteConfig } from "../../config";
import type { FullscreenWallpaperConfig, MediaSource } from "../../types/config";

interface Props {
	config: FullscreenWallpaperConfig;
	className?: string;
}

const { config, className } = Astro.props;

type MediaItem = MediaSource | string;

const isMediaSource = (item: MediaItem): item is MediaSource => {
	return typeof item === "object" && item !== null && "type" in item;
};

const isVideo = (item: MediaItem): boolean => {
	if (isMediaSource(item)) {
		return item.type === "video";
	}
	if (typeof item === "string") {
		const videoExtensions = [".mp4", ".webm", ".ogg", ".mov", ".avi"];
		return videoExtensions.some((ext) => item.toLowerCase().endsWith(ext));
	}
	return false;
};

const getMediaSrc = (item: MediaItem): string => {
	return isMediaSource(item) ? item.src : item;
};

const getMediaConfig = (item: MediaItem) => {
	if (isMediaSource(item)) {
		return {
			poster: item.poster,
			autoplay: item.autoplay ?? true,
			muted: item.muted ?? true,
			loop: item.loop ?? true,
			playsinline: item.playsinline ?? true,
		};
	}
	return {
		poster: undefined,
		autoplay: true,
		muted: true,
		loop: true,
		playsinline: true,
	};
};

const getMediaSources = async () => {
	let srcConfig = config.src;

	if (siteConfig.banner.imageApi?.enable && siteConfig.banner.imageApi?.url) {
		try {
			const response = await fetch(siteConfig.banner.imageApi.url);
			const text = await response.text();
			const apiImages = text.split("\n").filter((line) => line.trim());
			if (apiImages.length > 0) {
				return { desktop: apiImages, mobile: apiImages };
			}
		} catch (error) {
			console.warn("Failed to fetch images from API:", error);
		}
	}

	const toArray = (src: string | string[] | MediaSource[] | undefined): MediaItem[] =>
		Array.isArray(src) ? src : typeof src === "string" ? [src] : [];

	if (typeof srcConfig === "object" && srcConfig !== null && !Array.isArray(srcConfig)) {
		const desktop = toArray(srcConfig.desktop);
		const mobile = toArray(srcConfig.mobile);
		return {
			desktop: desktop.length > 0 ? desktop : mobile,
			mobile: mobile.length > 0 ? mobile : desktop,
		};
	}

	const allMedia = toArray(srcConfig as string | MediaItem[]);
	return { desktop: allMedia, mobile: allMedia };
};

const mediaSources = await getMediaSources();
const hasDesktopMedia = mediaSources.desktop.length > 0;
const hasMobileMedia = mediaSources.mobile.length > 0;

if (!hasDesktopMedia && !hasMobileMedia) return null;

const isCarouselEnabled = config.carousel?.enable &&
	(mediaSources.desktop.length > 1 || mediaSources.mobile.length > 1);
const carouselInterval = config.carousel?.interval || 5;

const position = config.position || "center";
const zIndex = config.zIndex || -1;
const opacity = config.opacity || 0.8;
const blurAmount = config.blur || 0;
const positionClass = (() => {
	switch (position) {
		case "top": return "object-top";
		case "bottom": return "object-bottom";
		default: return "object-center";
	}
})();

const renderGroups = [
	{
		key: 'desktop',
		media: mediaSources.desktop,
		containerClass: "hidden md:block",
		hasMedia: hasDesktopMedia
	},
	{
		key: 'mobile',
		media: mediaSources.mobile,
		containerClass: "block md:hidden",
		hasMedia: hasMobileMedia
	}
];
---

<div
	class:list={[
		"fixed inset-0 w-full h-full overflow-hidden pointer-events-none",
		className
	]}
	style={`z-index: ${zIndex}; opacity: ${opacity}; transform: translateZ(0); perspective: 1000px;`}
	data-fullscreen-wallpaper
>
	<script is:inline>
	(function() {
		const mode = localStorage.getItem('wallpaperMode') || 'banner';
		if (mode !== 'fullscreen') {
			document.currentScript.parentElement.style.display = 'none';
		}
	})();
	</script>

	{isCarouselEnabled ? (
		renderGroups.map(group => group.hasMedia && (
			<div class={`${group.containerClass} w-full h-full relative`} style="transform: translateZ(0);">
				{group.media.map((item, index) => {
					const src = getMediaSrc(item);
					const isVideoItem = isVideo(item);
					const mediaConfig = getMediaConfig(item);
					const baseStyle = `transform: translateZ(0); backface-visibility: hidden; will-change: opacity; ${blurAmount > 0 ? `filter: blur(${blurAmount}px);` : ''}; opacity: ${index === 0 ? 1 : 0};`;
					
					return isVideoItem ? (
						<video
							src={src}
							poster={mediaConfig.poster}
							autoplay={mediaConfig.autoplay}
							muted={mediaConfig.muted}
							loop={mediaConfig.loop}
							playsinline={mediaConfig.playsinline}
							class={`absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ${positionClass}`}
							data-carousel-item={index}
							style={baseStyle}
						/>
					) : (
						<img
							src={src}
							alt={`${group.key} wallpaper ${index + 1}`}
							class={`absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ${positionClass}`}
							data-carousel-item={index}
							style={baseStyle}
							decoding="async"
							loading={index === 0 ? "eager" : "lazy"}
						/>
					);
				})}
			</div>
		))
	) : (
		<div id="wallpaper-single-container" class="w-full h-full relative">
			<script is:inline define:vars={{ desktopMedia: mediaSources.desktop.map(m => ({ src: getMediaSrc(m), isVideo: isVideo(m), config: getMediaConfig(m) })), mobileMedia: mediaSources.mobile.map(m => ({ src: getMediaSrc(m), isVideo: isVideo(m), config: getMediaConfig(m) })), positionClass, blurAmount }}>
				(function() {
					const getRandomMedia = (media, storageKey) => {
						if (media.length === 0) return null;
						if (media.length === 1) return media[0];
						
						const lastIndex = sessionStorage.getItem(storageKey);
						let newIndex;
						
						do {
							newIndex = Math.floor(Math.random() * media.length);
						} while (newIndex === parseInt(lastIndex || '-1'));
						
						sessionStorage.setItem(storageKey, newIndex.toString());
						return media[newIndex];
					};
					
					const desktopItem = getRandomMedia(desktopMedia, 'wallpaper_desktop_index');
					const mobileItem = getRandomMedia(mobileMedia, 'wallpaper_mobile_index');
					
					const container = document.getElementById('wallpaper-single-container');
					
					if (desktopItem) {
						const desktopDiv = document.createElement('div');
						desktopDiv.className = 'hidden lg:block w-full h-full relative';
						desktopDiv.style.transform = 'translateZ(0)';
						const baseStyle = `transform: translateZ(0); backface-visibility: hidden; will-change: opacity; ${blurAmount > 0 ? `filter: blur(${blurAmount}px);` : ''} opacity: 1;`;
						
						if (desktopItem.isVideo) {
							desktopDiv.innerHTML = `
								<video
									src="${desktopItem.src}"
									poster="${desktopItem.config.poster || ''}"
									autoplay
									muted
									loop
									playsinline
									class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ${positionClass}"
									style="${baseStyle}"
								></video>
							`;
						} else {
							desktopDiv.innerHTML = `
								<img
									src="${desktopItem.src}"
									alt="desktop wallpaper"
									class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ${positionClass}"
									style="${baseStyle}"
									decoding="async"
									loading="eager"
								/>
							`;
						}
						container.appendChild(desktopDiv);
					}
					
					if (mobileItem) {
						const mobileDiv = document.createElement('div');
						mobileDiv.className = 'block lg:hidden w-full h-full relative';
						mobileDiv.style.transform = 'translateZ(0)';
						const baseStyle = `transform: translateZ(0); backface-visibility: hidden; will-change: opacity; ${blurAmount > 0 ? `filter: blur(${blurAmount}px);` : ''} opacity: 1;`;
						
						if (mobileItem.isVideo) {
							mobileDiv.innerHTML = `
								<video
									src="${mobileItem.src}"
									poster="${mobileItem.config.poster || ''}"
									autoplay
									muted
									loop
									playsinline
									class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ${positionClass}"
									style="${baseStyle}"
								></video>
							`;
						} else {
							mobileDiv.innerHTML = `
								<img
									src="${mobileItem.src}"
									alt="mobile wallpaper"
									class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ${positionClass}"
									style="${baseStyle}"
									decoding="async"
									loading="eager"
								/>
							`;
						}
						container.appendChild(mobileDiv);
					}
				})();
			</script>
		</div>
	)}
</div>

{isCarouselEnabled && (
	<script is:inline define:vars={{ carouselInterval }}>
		function initFullscreenWallpaperCarousel() {
			const container = document.querySelector('[data-fullscreen-wallpaper]');
			if (!container) return;

			if (window.__wallpaper_cleanup) {
				window.__wallpaper_cleanup();
				window.__wallpaper_cleanup = null;
			}

			const STORAGE_KEY = 'mizuki_wallpaper_index';
			let savedIndex = parseInt(sessionStorage.getItem(STORAGE_KEY) || '0');

			const groups = [
				container.querySelectorAll('.hidden.md\\:block [data-carousel-item]'),
				container.querySelectorAll('.block.md\\:hidden [data-carousel-item]')
			];

			const state = groups.map(items => {
				const safeIndex = (savedIndex >= 0 && savedIndex < items.length) ? savedIndex : 0;
				return {
					items,
					currentIndex: safeIndex,
					timer: null,
					active: items.length > 1
				};
			});

			function initImage(stateItem) {
				const { items, currentIndex } = stateItem;
				for (let i = 0; i < items.length; i++) {
					items[i].style.opacity = i === currentIndex ? '1' : '0';
					const video = items[i].querySelector('video') || (items[i].tagName === 'VIDEO' ? items[i] : null);
					if (video) {
						if (i === currentIndex) {
							video.play().catch(() => {});
						} else {
							video.pause();
						}
					}
				}
			}

			function switchNextImage(stateItem) {
				const { items, currentIndex } = stateItem;
				const nextIndex = (currentIndex + 1) % items.length;
				
				items[currentIndex].style.opacity = '0';
				items[nextIndex].style.opacity = '1';
				
				const currentVideo = items[currentIndex].querySelector('video') || (items[currentIndex].tagName === 'VIDEO' ? items[currentIndex] : null);
				const nextVideo = items[nextIndex].querySelector('video') || (items[nextIndex].tagName === 'VIDEO' ? items[nextIndex] : null);
				
				if (currentVideo) {
					currentVideo.pause();
				}
				if (nextVideo) {
					nextVideo.currentTime = 0;
					nextVideo.play().catch(() => {});
				}
				
				stateItem.currentIndex = nextIndex;

				sessionStorage.setItem(STORAGE_KEY, nextIndex.toString());
			}

			function start() {
				state.forEach(s => {
					if (s.active && !s.timer) {
						s.timer = setInterval(() => {
							if (!document.body.contains(s.items[0])) {
								stop();
								return;
							}
							switchNextImage(s);
						}, carouselInterval * 1000);
					}
				});
			}

			function stop() {
				state.forEach(s => {
					if (s.timer) {
						clearInterval(s.timer);
						s.timer = null;
					}
				});
			}

			const handleVisibilityChange = () => {
				if (document.hidden) {
					stop();
					state.forEach(s => {
						s.items.forEach(item => {
							const video = item.querySelector('video') || (item.tagName === 'VIDEO' ? item : null);
							if (video) video.pause();
						});
					});
				} else {
					const exists = state.some(s => s.items.length > 0 && document.body.contains(s.items[0]));
					if (exists) {
						start();
						state.forEach(s => {
							const video = s.items[s.currentIndex]?.querySelector('video') || (s.items[s.currentIndex]?.tagName === 'VIDEO' ? s.items[s.currentIndex] : null);
							if (video) video.play().catch(() => {});
						});
					}
				}
			};

			state.forEach(s => {
				if (s.items.length > 0) initImage(s);
			});

			start();

			document.addEventListener('visibilitychange', handleVisibilityChange);

			window.__wallpaper_cleanup = () => {
				stop();
				document.removeEventListener('visibilitychange', handleVisibilityChange);
			};
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initFullscreenWallpaperCarousel);
		} else {
			initFullscreenWallpaperCarousel();
		}
	</script>
)}
